{
  "name": "catalog-audit",
  "version": "1.0.0",
  "description": "Cross-references Testiny regression catalogs against actual code activity to flag coverage gaps, stale catalogs, and orphaned test cases.",
  "type": "module",
  "bin": {
    "catalog-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:fixture": "tsx test/fixtures/run-fixture-audit.ts"
  },
  "keywords": [
    "testiny",
    "regression",
    "catalog",
    "audit",
    "coverage",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "minimatch": "^10.0.1",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
